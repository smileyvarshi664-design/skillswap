# Render Port (Render sets this automatically in production)
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/skillswap?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key for token signing
JWT_SECRET=your_jwt_secret_key_here

# JWT Expiration
JWT_EXPIRE=7d

# Allowed Frontend Client URL (e.g. your Vercel deployment URL)
CLIENT_URL=http://localhost:5173
